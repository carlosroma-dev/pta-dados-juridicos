# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  .env.example — PTA Dados 2026                                              ║
# ║  Copie para .env e preencha os valores reais. Nunca comite o .env.           ║
# ║  Em produção: Railway usa "Variables", Streamlit Cloud usa "Secrets".        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Banco de Dados ─────────────────────────────────────────────────────────────
# Local: aponta pro container do docker-compose.
# Railway: injetado automaticamente — não setar manualmente.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pta_dados

# ── Autenticação da API ────────────────────────────────────────────────────────
# Gerar em produção com: openssl rand -hex 32
# Se não configurado, a API sobe sem autenticação (só em dev local).
API_KEY=troque_por_uma_chave_segura

# ── LLM (OpenAI) ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sua_chave_aqui
LLM_MODEL=gpt-5.4-mini-2026-03-17

# ── Interface Streamlit (Fase 3) ───────────────────────────────────────────────
# Em produção: URL pública do serviço api no Railway.
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30

# ── Google Drive (watcher de PDFs) ────────────────────────────────────────────
# Desligado por padrão em produção (DRIVE_UPLOAD_ENABLED=false).
# Para habilitar: fornecer o JSON da service account via variável de ambiente,
# nunca como arquivo commitado.
DRIVE_UPLOAD_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
DRIVE_FOLDER_ID=seu_id_da_pasta
DRIVE_POLL_INTERVAL=60

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=sua_chave_aqui
EMAIL_FROM=onboarding@resend.dev
EMAIL_FALLBACK=seu_email@gmail.com

# ── Emails dos advogados ───────────────────────────────────────────────────────
EMAIL_DR_BARROS=barros@escritorio.com
EMAIL_DRA_CAVALCANTE=cavalcante@escritorio.com
EMAIL_DR_MELO=melo@escritorio.com
EMAIL_DRA_FONTES=fontes@escritorio.com